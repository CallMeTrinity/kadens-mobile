# tourner Symfony, JAMAIS localhost : sur le téléphone, localhost désigne le
# téléphone. Voir le README (§ Développement contre un Symfony local).
#
#   prod : https://kadens.antoninpamart.fr
#   dev  : http://192.168.1.42:8000
EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
