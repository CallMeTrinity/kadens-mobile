{
  "expo": {
    "name": "Kadens Live",
    "slug": "kadens",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "scheme": "kadens",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "android": {
      "package": "fr.antoninpamart.kadens",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png"
      },
      "permissions": ["android.permission.VIBRATE"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Autorise Kadens Live à utiliser l’appareil photo pour scanner le QR d’appairage.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification.png",
          "color": "#d8261e",
          "defaultChannel": "rest"
        }
      ],
      "./plugins/with-release-signing.js",
      "./plugins/with-app-size.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
