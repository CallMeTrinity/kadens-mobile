# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (.env.example est versionné, lui)
.env
.env*.local

# typescript
*.tsbuildinfo

# Dossiers natifs : régénérés par `expo prebuild`, jamais versionnés.
# Toute configuration native passe donc par un plugin déclaré dans app.json —
# une édition manuelle serait effacée au prochain build.
/ios
/android
